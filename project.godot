"type": "float",
"value": 0.0
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
water_reflections={
"type": "float",
"value": 1.0
}
pixel_texels={
"type": "float",
"value": 64.0
}
wind_strength={
"type": "float",
"value": 1.0
}
player_position={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
