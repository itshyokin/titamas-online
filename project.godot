; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Titamas Online"
config/description="Small-group co-op 3D RPG set in the world of Titamas."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"
Database="*res://scripts/core/database.gd"
GameSession="*res://scripts/core/game_session.gd"
Net="*res://scripts/core/net.gd"
Achievements="*res://scripts/core/achievements.gd"
UiSounds="*res://scripts/ui/ui_sounds.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/titamas_database/plugin.cfg", "res://addons/prop_painter/plugin.cfg")

