		{
			"id": "insignia_villager",
			"name": "Villager with a request",
			"note": "Example: an NPC on an event page (model npc:villager) with a small quest.",
			"pages": [
				{
					"commands": [
						{
							"cmd": "text",
							"speaker": "",
							"text": "Bandits took my brother's cart last week."
						},
						{
							"cmd": "text",
							"speaker": "",
							"text": "If you bring me 3 bandit insignias, I'll make it worth your while."
						},
						{
							"accepted": [
								{
									"cmd": "switch",
									"id": "insignia_quest",
									"value": true
								},
								{
									"cmd": "text",
									"speaker": "",
									"text": "Thank you! Come back when you have them."
								}
							],
							"cmd": "quest",
							"declined": [
								{
									"cmd": "text",
									"speaker": "",
									"text": "I understand."
								}
							],
							"id": "bandit_insignias",
							"op": "offer"
						}
					],
					"conditions": [],
					"freeze": true,
					"marker": false,
					"model": "npc:villager",
					"prompt": "",
					"solid": false,
					"speaker": "",
					"trigger": "action"
				},
				{
					"commands": [
						{
							"cmd": "if",
							"conditions": [
								{
									"id": "bandit_insignias",
									"state": "ready",
									"type": "quest"
								}
							],
							"else": [
								{
									"cmd": "text",
									"speaker": "",
									"text": "Any luck with those insignias? I need 3."
								}
							],
							"then": [
								{
									"cmd": "text",
									"speaker": "",
									"text": "You found them! Here, take this."
								},
								{
									"cmd": "quest",
									"id": "bandit_insignias",
									"op": "complete"
								},
								{
									"cmd": "switch",
									"id": "insignia_done",
									"value": true
								},
								{
									"cmd": "achievement",
									"id": "BANDIT_BASHER"
								}
							]
						}
					],
					"conditions": [
						{
							"id": "insignia_quest",
							"is": true,
							"type": "switch"
						}
					],
					"freeze": true,
					"marker": false,
					"model": "npc:villager",
